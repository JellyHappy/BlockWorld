      8  10000 ????
      9  10000 ????		00 ed	    spare      =	z
     10  10000 ????
     11  10000 ????		00 ec	    oldx       =	y
     12  10000 ????
     13  10000 ????		00 eb	    deaths     =	x
     14  10000 ????
     15  10000 ????		00 ea	    selectlock =	w
     16  10000 ????
     17  10000 ????		00 e9	    turn       =	v
     18  10000 ????
     19  10000 ????		00 e8	    mode       =	u
     20  10000 ????
     21  10000 ????		00 e7	    soundkind  =	t
     22  10000 ????
     23  10000 ????		00 e6	    ledgeend   =	s
     24  10000 ????
     25  10000 ????		00 e5	    ledgex     =	r
     26  10000 ????
     27  10000 ????		00 e4	    bricky     =	q
     28  10000 ????
     29  10000 ????		00 e3	    brickx     =	p
     30  10000 ????
     31  10000 ????		00 e2	    state      =	o
     32  10000 ????
     33  10000 ????		00 e1	    firelock   =	n
